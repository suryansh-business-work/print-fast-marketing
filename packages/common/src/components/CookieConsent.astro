---
// Cookie consent — compact floating card (bottom-right) with category toggles behind "Customize".
// Persists detailed preferences in localStorage under "pf-cookie-consent-v1":
//   { choice: 'accepted'|'rejected'|'custom', categories: { essential, functional, analytics, marketing }, ts }
// Floating launcher sits ABOVE the accessibility launcher (bottom-5).
import { mainHref } from '@config/sites';
---

<!-- Floating launcher -->
<button
  type="button"
  data-cookie-open
  aria-label="Cookie preferences"
  aria-controls="cookie-drawer"
  aria-expanded="false"
  class="fixed bottom-[5.25rem] right-5 z-[60] grid h-12 w-12 place-items-center rounded-full bg-ink-900 text-brand-400 shadow-glow ring-2 ring-white hover:bg-ink-800 focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-400 transition-transform hover:scale-105 dark:ring-ink-800"
>
  <i class="fa-solid fa-cookie-bite text-xl" aria-hidden="true"></i>
</button>

<!-- Compact card -->
<aside
  id="cookie-drawer"
  data-cookie-drawer
  role="dialog"
  aria-labelledby="cookie-title"
  tabindex="-1"
  class="fixed bottom-3 left-3 right-3 sm:left-auto sm:bottom-5 sm:right-5 sm:w-[340px] z-[80] max-h-[calc(100vh-1.5rem)] overflow-y-auto rounded-2xl border border-ink-100 bg-white p-4 shadow-2xl dark:border-ink-800 dark:bg-ink-900 transition-all duration-200 ease-out focus:outline-none focus-visible:ring-0 focus-visible:ring-offset-0 invisible opacity-0 translate-y-3"
>
  <!-- Header -->
  <header class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-2 min-w-0">
      <span class="grid h-8 w-8 flex-shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 dark:bg-brand-950/40 dark:text-brand-300">
        <i class="fa-solid fa-cookie-bite text-sm" aria-hidden="true"></i>
      </span>
      <h2 id="cookie-title" class="text-sm font-display font-bold text-ink-900 dark:text-white">
        Cookie preferences
      </h2>
    </div>
    <button
      type="button"
      data-cookie-close
      aria-label="Close cookie preferences"
      class="grid h-7 w-7 flex-shrink-0 place-items-center rounded-full text-ink-500 hover:bg-ink-50 dark:hover:bg-ink-800"
    >
      <i class="fa-solid fa-xmark text-sm" aria-hidden="true"></i>
    </button>
  </header>

  <p class="mt-2 text-xs text-ink-600 dark:text-ink-300 leading-relaxed">
    We use cookies to improve your experience and analyse site traffic.
    Read our <a href={mainHref('/contact-us/')} class="text-brand-700 dark:text-brand-400 underline underline-offset-2 hover:text-brand-800">privacy policy</a>.
  </p>

  <!-- Actions -->
  <div class="mt-3 grid grid-cols-2 gap-2">
    <button type="button" data-cookie-reject class="btn-outline w-full px-3 py-2 text-xs">
      Reject all
    </button>
    <button type="button" data-cookie-accept class="btn-primary w-full px-3 py-2 text-xs">
      Accept all
    </button>
  </div>

  <button
    type="button"
    data-cookie-customize
    aria-expanded="false"
    aria-controls="cookie-prefs"
    class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-600 hover:text-brand-700 dark:text-ink-300 dark:hover:text-brand-400"
  >
    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
    Customize
    <i class="fa-solid fa-chevron-down text-[10px] transition-transform" data-cookie-chevron aria-hidden="true"></i>
  </button>

  <!-- Categories -->
  <div id="cookie-prefs" data-cookie-prefs hidden class="mt-2 border-t border-ink-100 pt-2 dark:border-ink-800">
    <ul class="divide-y divide-ink-100 dark:divide-ink-800">
      <!-- Essential -->
      <li>
        <label class="flex items-center justify-between gap-3 py-2 cursor-not-allowed">
          <span class="flex items-center gap-2 text-xs font-semibold text-ink-900 dark:text-white">
            <i class="fa-solid fa-shield-halved w-3.5 text-brand-600 dark:text-brand-400" aria-hidden="true"></i>
            Strictly necessary
            <span class="text-[9px] font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-brand-950/40 px-1 py-0.5 rounded">Always on</span>
          </span>
          <input type="checkbox" checked disabled class="sr-only peer" />
          <span class="relative h-5 w-9 flex-shrink-0 rounded-full bg-brand-600 opacity-70 after:content-[''] after:absolute after:top-0.5 after:left-[18px] after:h-4 after:w-4 after:rounded-full after:bg-white"></span>
        </label>
      </li>

      <!-- Functional -->
      <li>
        <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
          <span class="flex items-center gap-2 text-xs font-semibold text-ink-900 dark:text-white">
            <i class="fa-solid fa-sliders w-3.5 text-ink-700 dark:text-ink-200" aria-hidden="true"></i>
            Functional
          </span>
          <input type="checkbox" data-cookie-cat="functional" class="sr-only peer" checked />
          <span class="relative h-5 w-9 flex-shrink-0 rounded-full bg-ink-300 dark:bg-ink-700 peer-checked:bg-brand-600 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all peer-checked:after:translate-x-4"></span>
        </label>
      </li>

      <!-- Analytics -->
      <li>
        <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
          <span class="flex items-center gap-2 text-xs font-semibold text-ink-900 dark:text-white">
            <i class="fa-solid fa-chart-line w-3.5 text-ink-700 dark:text-ink-200" aria-hidden="true"></i>
            Analytics
          </span>
          <input type="checkbox" data-cookie-cat="analytics" class="sr-only peer" checked />
          <span class="relative h-5 w-9 flex-shrink-0 rounded-full bg-ink-300 dark:bg-ink-700 peer-checked:bg-brand-600 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all peer-checked:after:translate-x-4"></span>
        </label>
      </li>

      <!-- Marketing -->
      <li>
        <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
          <span class="flex items-center gap-2 text-xs font-semibold text-ink-900 dark:text-white">
            <i class="fa-solid fa-bullhorn w-3.5 text-ink-700 dark:text-ink-200" aria-hidden="true"></i>
            Marketing
          </span>
          <input type="checkbox" data-cookie-cat="marketing" class="sr-only peer" />
          <span class="relative h-5 w-9 flex-shrink-0 rounded-full bg-ink-300 dark:bg-ink-700 peer-checked:bg-brand-600 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400 transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-all peer-checked:after:translate-x-4"></span>
        </label>
      </li>
    </ul>

    <button type="button" data-cookie-save class="btn-outline mt-2 w-full px-3 py-2 text-xs">
      Save preferences
    </button>
  </div>
</aside>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'pf-cookie-consent-v1';
    var HIDDEN = ['invisible', 'opacity-0', 'translate-y-3'];
    var drawer = document.querySelector('[data-cookie-drawer]');
    var openBtn = document.querySelector('[data-cookie-open]');
    var closeBtn = document.querySelector('[data-cookie-close]');
    var acceptBtn = document.querySelector('[data-cookie-accept]');
    var rejectBtn = document.querySelector('[data-cookie-reject]');
    var saveBtn = document.querySelector('[data-cookie-save]');
    var customizeBtn = document.querySelector('[data-cookie-customize]');
    var prefs = document.querySelector('[data-cookie-prefs]');
    var chevron = document.querySelector('[data-cookie-chevron]');
    var toggles = document.querySelectorAll('[data-cookie-cat]');

    if (!drawer || !openBtn) return;

    function setToggle(name, value) {
      for (var i = 0; i < toggles.length; i++) {
        if (toggles[i].getAttribute('data-cookie-cat') === name) toggles[i].checked = !!value;
      }
    }
    function readToggles() {
      var cats = { essential: true, functional: false, analytics: false, marketing: false };
      for (var i = 0; i < toggles.length; i++) {
        cats[toggles[i].getAttribute('data-cookie-cat')] = !!toggles[i].checked;
      }
      return cats;
    }
    function setPrefsOpen(open) {
      if (!prefs || !customizeBtn) return;
      prefs.hidden = !open;
      customizeBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      chevron && chevron.classList.toggle('rotate-180', open);
    }
    function isOpen() {
      return !drawer.classList.contains('invisible');
    }
    function openDrawer(showPrefs) {
      setPrefsOpen(!!showPrefs);
      drawer.classList.remove.apply(drawer.classList, HIDDEN);
      openBtn.setAttribute('aria-expanded', 'true');
      setTimeout(function () { drawer.focus({ preventScroll: true }); }, 50);
    }
    function closeDrawer() {
      drawer.classList.add.apply(drawer.classList, HIDDEN);
      openBtn.setAttribute('aria-expanded', 'false');
    }
    function persist(choice, categories) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          choice: choice,
          categories: categories,
          ts: Date.now()
        }));
      } catch (_) { /* ignore */ }
      closeDrawer();
    }

    // Restore previous choice into toggles (if any)
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        var saved = JSON.parse(raw);
        if (saved && saved.categories) {
          setToggle('functional', saved.categories.functional);
          setToggle('analytics', saved.categories.analytics);
          setToggle('marketing', saved.categories.marketing);
        }
      }
    } catch (_) { /* ignore */ }

    // The launcher is how returning visitors change their choice, so show the toggles straight away.
    openBtn.addEventListener('click', function () {
      if (isOpen()) closeDrawer();
      else openDrawer(true);
    });
    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    customizeBtn && customizeBtn.addEventListener('click', function () {
      setPrefsOpen(prefs.hidden);
    });

    acceptBtn && acceptBtn.addEventListener('click', function () {
      setToggle('functional', true);
      setToggle('analytics', true);
      setToggle('marketing', true);
      persist('accepted', { essential: true, functional: true, analytics: true, marketing: true });
    });
    rejectBtn && rejectBtn.addEventListener('click', function () {
      setToggle('functional', false);
      setToggle('analytics', false);
      setToggle('marketing', false);
      persist('rejected', { essential: true, functional: false, analytics: false, marketing: false });
    });
    saveBtn && saveBtn.addEventListener('click', function () {
      persist('custom', readToggles());
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) closeDrawer();
    });

    // Auto-open on first visit
    var hasChoice = false;
    try { hasChoice = !!localStorage.getItem(STORAGE_KEY); } catch (_) { /* ignore */ }
    if (!hasChoice) setTimeout(function () { openDrawer(false); }, 800);
  })();
</script>
