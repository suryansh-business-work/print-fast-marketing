---
import ContactFormReact from './ContactFormReact.tsx';
import { SITE } from '@data/site';
import { mainHref } from '@config/sites';

export interface Props {
  title?: string;
  subtitle?: string;
  variant?: 'general' | 'review';
}
const { title, subtitle, variant = 'general' } = Astro.props;
---

<ContactFormReact
  client:load
  variant={variant}
  title={title}
  subtitle={subtitle}
  phone={SITE.phone}
  phoneHref={SITE.phoneHref}
  email={SITE.email}
  termsHref={mainHref('/terms-of-use/')}
  privacyHref={mainHref('/privacy-policy/')}
/>
