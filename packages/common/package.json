{
  "name": "@print-fast/common",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design system for the PrintFast sites — layouts, components, data, styles, SEO helpers and the Tailwind preset. Consumed as source (no build step) by every Astro app.",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind.preset.mjs",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "public",
    "tailwind.preset.mjs"
  ],
  "peerDependencies": {
    "astro": "^5.18.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@mui/material": "^9.0.1",
    "formik": "^2.4.9",
    "leaflet": "^1.9.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "sass": "^1.83.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
