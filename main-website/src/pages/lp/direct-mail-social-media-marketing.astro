    <header class="sticky top-0 z-50 border-b border-ink-100 bg-white">
      <div class={`${wrap} flex h-16 items-center justify-between gap-3 sm:h-[76px]`}>
        <a href={mainHref('/')} class="flex shrink-0 items-center" aria-label={`${SITE.fullName} home`}>
