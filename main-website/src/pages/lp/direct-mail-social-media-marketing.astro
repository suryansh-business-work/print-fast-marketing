<script>
  import { submitTerritoryPlanToZoho } from '@config/zoho-territory-plan';

  // --- Countdown badge -------------------------------------------------------
  // The page is static, so the badge printed at build time is re-counted in the
  // visitor's browser against the same Eastern-time deadline.
  const badge = document.querySelector<HTMLElement>('[data-countdown]');
  if (badge?.dataset.deadline) {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' }).format(new Date());
    const days = Math.round((Date.parse(badge.dataset.deadline) - Date.parse(today)) / 86_400_000);
    const label = days > 1 ? `(${days} days left)` : days === 1 ? '(1 day left)' : days === 0 ? '(Last day)' : '';
    badge.textContent = label;
    badge.hidden = !label;
  }

  // --- Calculator ------------------------------------------------------------
  const calc = document.querySelector<HTMLElement>('[data-calculator]');
  const calcFields = ['calc-homes', 'calc-rate', 'calc-close', 'calc-ticket'].map(
    (id) => document.getElementById(id) as HTMLInputElement,
  );
  const whole = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 });
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

  const readCalc = () => {
    const [homes, rate, close, ticket] = calcFields.map((input) => Math.max(0, Number(input.value) || 0));
    const calls = Math.round(homes * (rate / 100));
    const jobs = Math.round(calls * (close / 100));
    return { homes, rate, close, ticket, calls, jobs, revenue: jobs * ticket };
  };

  const renderCalc = () => {
    const { calls, jobs, revenue } = readCalc();
    calc!.querySelector('[data-calc-calls]')!.textContent = whole.format(calls);
    calc!.querySelector('[data-calc-jobs]')!.textContent = whole.format(jobs);
    calc!.querySelector('[data-calc-revenue]')!.textContent = money.format(revenue);
  };

  if (calc) {
    calcFields.forEach((input) => input.addEventListener('input', renderCalc));
    renderCalc();
  }

  // --- Territory Plan form ---------------------------------------------------
  const form = document.getElementById('plan-form') as HTMLFormElement;
  const stepOne = form.querySelector<HTMLFieldSetElement>('[data-step="1"]')!;
  const stepTwo = form.querySelector<HTMLFieldSetElement>('[data-step="2"]')!;
  const progress = document.querySelector<HTMLElement>('[data-plan-progress]')!;
  const errorBox = form.querySelector<HTMLElement>('[data-plan-error]')!;
  const submitButton = form.querySelector<HTMLButtonElement>('[data-plan-submit]')!;
  const planCard = document.getElementById('plan')!;

  const showStep = (step: 1 | 2) => {
    stepOne.hidden = step !== 1;
    stepTwo.hidden = step !== 2;
    progress.style.backgroundImage = step === 2 ? 'linear-gradient(90deg, #ED1C24, #c8161d)' : '';
    const first = (step === 1 ? stepOne : stepTwo).querySelector<HTMLElement>('select, input');
    first?.focus({ preventScroll: true });
    if (planCard.getBoundingClientRect().top < 0) planCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  /**
   * Native validation, one step at a time: the hidden step must not block the
   * visible one. Text is trimmed first, so a field of spaces fails here as
   * empty instead of reaching Zoho and being refused there.
   */
  const stepIsValid = (step: HTMLFieldSetElement) => {
    const fields = Array.from(step.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select'));
    fields.forEach((field) => {
      if (field instanceof HTMLInputElement && ['text', 'email', 'tel'].includes(field.type)) field.value = field.value.trim();
    });
    const invalid = fields.find((field) => !field.checkValidity());
    invalid?.reportValidity();
    return !invalid;
  };

  // "Just the mail" and the ad channels exclude each other.
  const channelBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="channels"]'));
  channelBoxes.forEach((box) =>
    box.addEventListener('change', () => {
      if (!box.checked) return;
      const mailOnly = box.hasAttribute('data-mail-only');
      channelBoxes.forEach((other) => {
        if (other !== box && other.hasAttribute('data-mail-only') !== mailOnly) other.checked = false;
      });
    }),
  );

  form.querySelector('[data-plan-back]')!.addEventListener('click', () => showStep(1));

  const finish = () => {
    document.querySelector<HTMLElement>('[data-plan-body]')!.hidden = true;
    document.querySelector<HTMLElement>('[data-plan-done]')!.hidden = false;
    planCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!stepOne.hidden) {
      if (stepIsValid(stepOne)) showStep(2);
      return;
    }
    if (!stepIsValid(stepTwo)) return;

    const data = new FormData(form);
    // A filled honeypot is a bot: thank it and send nothing.
    if (String(data.get('website') ?? '').trim()) return finish();

    errorBox.hidden = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    try {
      await submitTerritoryPlanToZoho({
        trade: String(data.get('trade')),
        towns: String(data.get('towns')),
        landing: String(data.get('landing')),
        channels: data.getAll('channels').map(String),
        spend: String(data.get('spend') ?? ''),
        firstName: String(data.get('firstName')),
        lastName: String(data.get('lastName')),
        email: String(data.get('email')),
        phone: String(data.get('phone')),
        company: String(data.get('company')),
        website: String(data.get('site') ?? ''),
        consent: data.get('consent') === 'on',
        pageUrl: window.location.href,
        gclid: new URLSearchParams(window.location.search).get('gclid') ?? undefined,
      });
      form.reset();
      finish();
    } catch {
      errorBox.hidden = false;
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send my free plan';
    }
  });

  // --- Plan CTAs -------------------------------------------------------------
  // Every "plan" button scrolls to the form; put the cursor in its first field.
  document.querySelectorAll<HTMLAnchorElement>('[data-plan-link]').forEach((anchor) =>
    anchor.addEventListener('click', () => {
      if (stepOne.hidden) return;
      window.setTimeout(() => document.getElementById('plan-trade')?.focus({ preventScroll: true }), 450);
    }),
  );
</script>
