// Decorative QR-style pattern for the sample postcard: three finder squares and
// seeded noise, so it reads as a QR code at a glance without encoding anything.
const QR_SIZE = 21;
const qrPath = (() => {
  let seed = 7;
  const rand = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
  const finders = [
    [0, 0],
    [QR_SIZE - 7, 0],
    [0, QR_SIZE - 7],
  ];
  let d = '';
  for (let y = 0; y < QR_SIZE; y++) {
    for (let x = 0; x < QR_SIZE; x++) {
      const finder = finders.find(([fx, fy]) => x >= fx - 1 && x <= fx + 7 && y >= fy - 1 && y <= fy + 7);
      let on: boolean;
      if (finder) {
        const ring = Math.max(Math.abs(x - finder[0] - 3), Math.abs(y - finder[1] - 3));
        on = ring !== 2 && ring <= 3;
      } else {
        on = rand() > 0.52;
      }
      if (on) d += `M${x} ${y}h1v1h-1z`;
    }
  }
  return d;
})();

