              <i class="fa-solid fa-phone" aria-hidden="true"></i>
            </span>
            <span class="hidden lg:inline">Talk to a person:</span>
            <span class="hidden sm:inline lg:ml-1">{SITE.phone}</span>
          </a>
          <a
            href={PLAN}
            data-plan-link
            class="inline-flex h-9 items-center rounded-md bg-brand-500 px-3 text-xs font-extrabold uppercase tracking-[0.025em] text-white shadow-[0_10px_30px_rgba(237,28,36,0.25)] transition hover:bg-brand-600 sm:h-[42px] sm:px-[18px] sm:text-[14px]"
          >
            Free Territory Plan
