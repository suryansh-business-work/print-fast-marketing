{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "../packages/common/src/*"
      ],
      "@common/*": [
        "../packages/common/src/*"
      ],
      "@components/*": [
        "../packages/common/src/components/*"
      ],
      "@layouts/*": [
        "../packages/common/src/layouts/*"
      ],
      "@styles/*": [
        "../packages/common/src/styles/*"
      ],
      "@data/*": [
        "../packages/common/src/data/*"
      ],
      "@config/*": [
        "../packages/common/src/config/*"
      ],
      "@seo/*": [
        "../packages/common/src/seo/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../packages/common/src/**/*",
    "astro.config.mjs",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
