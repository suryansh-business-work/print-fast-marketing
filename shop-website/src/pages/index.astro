---
import ShopLayout from '@layouts/ShopLayout.astro';
import { SHOP_GROUPS, SHOP_PAGES, shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');
const totalProducts = SHOP_PAGES.length;
---

<ShopLayout
  title="Shop PrintFast — Direct Mail, Print Products & Marketing Services"
  appendSiteName={true}
  description="Shop PrintFast for jumbo postcards, personalized mailers, door hangers, yard signs, stickers, newsletters and full-service direct mail printing built for HVAC, plumbing, electrical and home-service pros."
  keywords={[
    'PrintFast shop',
    'direct mail postcards for contractors',
    'home service print marketing',
    'HVAC postcards',
    'door hangers',
    'yard signs',
    'referral mailers',
    'full service printing',
  ]}
>
  <!-- ===================== HERO ===================== -->
  <!-- Full-bleed photographic banner: the artwork fades to white across its left
       third, so the copy sits in that zone on desktop and the photo stacks below
       it under `lg`. Styling lives in main.scss as .pf-banner-*. -->
  <section class="pf-banner-hero relative overflow-hidden pt-16 pb-12 lg:pt-24 lg:pb-20">
    <div aria-hidden="true" class="pf-banner-fade"></div>

    <div class="container-pf">
      <div class="max-w-xl lg:max-w-[46%]" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-store"></i> Shop PrintFast
        </p>
        <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-[#0f2747] sm:text-5xl">
          Print marketing that puts your brand <span class="text-[#ED1C24]">right in their hands</span>
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-600 sm:text-lg">
          Postcards, mailers, door hangers, yard signs, newsletters and full-service printing —
          {totalProducts}+ done-for-you products and services built to grow HVAC, plumbing, electrical
          and every home-service brand.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={contactHref}
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Get a Quote <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a
            href={shopHref('all-products')}
            class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-[#0f2747] ring-1 ring-ink-200 transition-all hover:ring-[#ED1C24] hover:text-[#c01620]"
          >
            Browse All Products
          </a>
        </div>
      </div>

      <img
        src="https://ik.imagekit.io/PFdigitalmarketing/Home%20Page%202026/PF_digital_marketing_homeservice_banner_SfEO_St1g.png"
        alt="HVAC technician beside a Comfort Solutions service van reviewing Google and Facebook ads for his home service business on a tablet"
        width="1672"
        height="941"
        class="pf-banner-img"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- ===================== GROUP SECTIONS ===================== -->
  {SHOP_GROUPS.map((group, gi) => (
    <section id={group.id} class:list={['section scroll-mt-32', gi % 2 === 1 && 'bg-ink-50/60']}>
      <div class="container-pf">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class:list={['fa-solid', group.icon]}></i> {group.title}
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">{group.title}</h2>
          <p class="lead mt-4">{group.description}</p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {group.pages.map((page) => (
            <a
              href={shopHref(page.slug)}
              class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40"
              data-reveal
            >
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-lg text-[#ED1C24] transition-colors group-hover:bg-[#ED1C24] group-hover:text-white">
                <i class:list={['fa-solid', page.icon]} aria-hidden="true"></i>
              </span>
              <h3 class="mt-5 text-base font-extrabold uppercase tracking-wide text-[#0f2747] group-hover:text-[#ED1C24]">
                {page.label}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{page.blurb}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]">
                Learn more <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ===================== FINAL CTA ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative max-w-3xl">
          <h2 class="heading-lg text-white">
            Not sure where to start? <span class="text-[#ED1C24]">We’ll build your plan.</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            Tell us about your trade and service area. We’ll recommend the right mix of postcards,
            mailers and print products — and handle design, printing and mailing end to end.
          </p>
          <a
            href={contactHref}
            class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Talk to a Marketing Specialist <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
