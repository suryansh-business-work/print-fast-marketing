---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// "Why Register?" benefits — verbatim from the original all-products page.
const benefits = [
  {
    icon: 'fa-unlock-keyhole',
    title: 'Exclusive Access',
    description:
      'Gain access to our complete product catalog, featuring hundreds of items tailored to home service professionals.',
  },
  {
    icon: 'fa-user-gear',
    title: 'Personalized Experience',
    description:
      'Create a personalized account to track your orders, create custom designs, manage your preferences, and receive tailored recommendations.',
  },
  {
    icon: 'fa-tags',
    title: 'Competitive Pricing',
    description:
      'Enjoy our competitive pricing and special offers available exclusively to registered customers.',
  },
  {
    icon: 'fa-shield-halved',
    title: 'Secure Shopping',
    description: 'Benefit from our secure checkout process and hassle-free returns.',
  },
];

// Public shop directory — the products & services visitors can explore right now.
// Every link resolves to a real shop page via shopHref().
const catalog = [
  {
    id: 'postcards',
    title: 'Postcards & Mailers',
    icon: 'fa-envelopes-bulk',
    items: [
      { label: 'All Postcards', href: shopHref('printfast-postcards') },
      { label: 'Radius Postcards', href: shopHref('radius-postcards') },
      { label: 'Seasonal Postcards', href: shopHref('seasonal-postcards') },
      { label: 'Service Request Postcards', href: shopHref('service-request-postcards') },
      { label: 'Thank You Postcards', href: shopHref('thank-you-postcards') },
      { label: 'Letters', href: shopHref('letters') },
      { label: 'Referral Mailers', href: shopHref('referral-mailers') },
      { label: 'Thank You Mailers', href: shopHref('thank-you-mailers') },
      { label: 'Membership Mailings', href: shopHref('membership-mailings') },
    ],
  },
  {
    id: 'products',
    title: 'Print Products',
    icon: 'fa-boxes-stacked',
    items: [
      { label: 'Products Overview', href: shopHref('products-retailer') },
      { label: 'Door Hangers', href: shopHref('door-hangers') },
      { label: 'Homeowner Experience Packs', href: shopHref('homeowner-experience-packs') },
      { label: 'Newsletters', href: shopHref('newsletters-new') },
      { label: 'Recruiting Cards', href: shopHref('recruiting-cards') },
      { label: 'Stickers', href: shopHref('stickers') },
      { label: 'Yard Signs', href: shopHref('yard-signs') },
    ],
  },
  {
    id: 'services',
    title: 'Services & Solutions',
    icon: 'fa-briefcase',
    items: [
      { label: 'Direct Mail Plus', href: shopHref('direct-mail-plus') },
      { label: 'Direct Mail', href: shopHref('direct-mail-page') },
      { label: 'Creative Design', href: shopHref('creative-design') },
      { label: 'Full Service Printing', href: shopHref('full-service-printing') },
      { label: 'Thank You Programs', href: shopHref('thank-you-programs') },
      { label: 'Website Services', href: shopHref('web-design') },
      { label: 'Mailing Lists', href: shopHref('mailing-lists') },
      { label: 'Free Digital Review', href: shopHref('free-digital-review') },
    ],
  },
];

const faqs = [
  {
    question: 'What products do you offer beyond the public shop?',
    answer:
      'The products and services you see in our public shop are just a glimpse of what we offer. Registered customers unlock our complete catalog of hundreds of print and direct mail marketing products tailored to home service professionals.',
  },
  {
    question: 'How much does it cost to register?',
    answer:
      "Registering is quick, easy, and absolutely free. Creating an account simply unlocks full catalog access, personalized recommendations, order tracking, and pricing reserved for registered customers.",
  },
  {
    question: 'What do I get when I create an account?',
    answer:
      'A personalized account lets you track your orders, create custom designs, manage your preferences, and receive tailored recommendations — plus competitive pricing and special offers available exclusively to registered customers.',
  },
  {
    question: 'Is checkout secure?',
    answer:
      'Yes. Every registered customer benefits from our secure checkout process and hassle-free returns, so you can order with confidence.',
  },
];
---

<ShopLayout
  title="All PrintFast Products | Unlock the Full Marketing Catalog"
  crumb="All PrintFast Products"
  description="Register free to unlock the full PrintFast product catalog — hundreds of print and direct mail marketing products built for home service pros, with personalized pricing and secure checkout."
  keywords={[
    'PrintFast products',
    'full product catalog',
    'home service marketing products',
    'direct mail products',
    'print marketing catalog',
    'register for full store access',
  ]}
  faqs={faqs}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'All PrintFast Products',
    description:
      'The full PrintFast catalog of print and direct mail marketing products for home service professionals.',
    isPartOf: { '@type': 'WebSite', name: 'PrintFast' },
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
            Full Product Catalog
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
            All <span class="text-[#ED1C24]">Products</span>
          </h1>
          <p class="mt-6 text-lg font-semibold text-white/90 sm:text-xl">
            Unleash your potential with our full product catalog.
          </p>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Discover a world of possibilities. The products and services you see in our public shop are
            just a glimpse of what we offer. To unlock the full potential of our marketing services and
            explore our extensive range of high-quality products, simply register for access.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Register Now <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href="#catalog"
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              Browse The Shop
            </a>
          </div>
        </div>

        <div class="relative" data-reveal>
          <div class="rounded-2xl bg-white p-2 shadow-glow sm:p-3">
            <iframe
              src="https://forms.zohopublic.com/printfastllc/form/FULLSTOREACCESSREQUEST/formperma/0xrudNws9IgRkss3QSOU6Y5f98mfHX8CivhsQkTqEjQ"
              title="Full Store Access Request"
              class="h-[560px] w-full rounded-xl border-0"
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY REGISTER ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-key"></i> Why Register?
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Unlock everything a registered account gives you</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((b) => (
          <div class="flex flex-col items-center rounded-2xl bg-white p-6 text-center ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span class="grid h-20 w-20 shrink-0 place-items-center rounded-2xl bg-[#fde8e9] text-3xl text-[#ED1C24]">
              <i class={`fa-solid ${b.icon}`}></i>
            </span>
            <h3 class="mt-4 text-sm font-extrabold uppercase tracking-wide text-[#0f2747]">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== BROWSE THE SHOP DIRECTORY ===================== -->
  <section id="catalog" class="section bg-ink-50/60 scroll-mt-24">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-grip"></i> Explore The Catalog
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Start browsing our marketing products</h2>
        <p class="lead mt-4">
          Here is a taste of what is available in the public shop. Register for free to see the full
          lineup, exclusive pricing, and every design.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {catalog.map((group) => (
          <div class="flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft" data-reveal>
            <div class="flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
                <i class={`fa-solid ${group.icon}`}></i>
              </span>
              <h3 class="text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{group.title}</h3>
            </div>
            <ul class="mt-5 space-y-1">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-50 hover:text-[#ED1C24]"
                  >
                    {item.label}
                    <i class="fa-solid fa-arrow-right text-xs text-ink-300 transition-all group-hover:translate-x-0.5 group-hover:text-[#ED1C24]"></i>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== READY TO EXPLORE MORE (CTA BANNER) ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 text-center sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative mx-auto max-w-3xl">
          <h2 class="heading-lg text-white">
            Ready to <span class="text-[#ED1C24]">explore more?</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            Register today to unlock a world of opportunities. It's quick, easy, and absolutely free.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Register Now <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href={shopHref('')}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              Visit Shop Home
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-circle-question"></i> FAQs
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Questions about full catalog access</h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft" data-reveal>
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-bold text-[#0f2747] marker:content-['']">
              {f.question}
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24] transition-transform group-open:rotate-45">
                <i class="fa-solid fa-plus text-xs"></i>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-ink-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== HAVE QUESTIONS / CONTACT ===================== -->
  <section class="section bg-ink-50/60 pt-0">
    <div class="container-pf">
      <div class="grid items-center gap-10 rounded-3xl bg-white p-8 ring-1 ring-ink-100 shadow-soft sm:p-12 lg:grid-cols-2" data-reveal>
        <div>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-headset"></i> Have Questions?
          </p>
          <h2 class="heading-md mt-4 text-[#0f2747]">We're here to help</h2>
          <p class="mt-4 text-ink-600">
            We're available from 8 AM to 5 PM ET, Monday to Friday — our team is here to help you find
            the right products and get registered for full store access.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <a
            href="tel:800-810-4818"
            class="flex items-center gap-4 rounded-2xl bg-[#0f2747] p-5 text-white transition-all hover:-translate-y-0.5"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[#ED1C24]">
              <i class="fa-solid fa-phone"></i>
            </span>
            <span>
              <span class="block text-xs font-bold uppercase tracking-[0.18em] text-white/60">Call us</span>
              <span class="block text-lg font-extrabold">800-810-4818</span>
            </span>
          </a>
          <a
            href={contactHref}
            class="flex items-center gap-4 rounded-2xl bg-white p-5 ring-1 ring-ink-100 transition-all hover:-translate-y-0.5 hover:ring-[#ED1C24]/40"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
              <i class="fa-solid fa-paper-plane"></i>
            </span>
            <span>
              <span class="block text-xs font-bold uppercase tracking-[0.18em] text-ink-400">Message us</span>
              <span class="block text-lg font-extrabold text-[#0f2747]">Contact Our Team</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
