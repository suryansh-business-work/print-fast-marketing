---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// Original PrintFast image assets (served from the same CDN the live store uses).
const CF = 'https://dqj17tese79do.cloudfront.net/printfast/images';

const ceoImg = `${CF}/contentimages/images/CEO.png`;

// The three pillars from the original "Our Team Delivers World Class Results" block.
const pillars = [
  {
    img: `${CF}/common/HSC_MarketingSuperstoreImage_6_2_2021_Billsedits.jpg?1642073008`,
    title: 'Print Products',
    description:
      'We offer hundreds of products and services to choose from. And since everything we do is custom-made, our solutions will always make you look your best — not like the rest. Our goal is to help grow your business! Just call us and we’ll guide you to the right solution to grow your company.',
  },
  {
    img: `${CF}/common/Coaching_Image62.jpg?1642072972`,
    title: 'We’ll Guide You',
    description:
      'Every client has their own unique products and services. Since our printing and direct mail offerings are custom-made solutions for your business, we’ll utilize our vast experience to guide you to the right solution each time. We’ll make the process simple and easy. Call us today — we’re really friendly to talk to!',
  },
  {
    img: `${CF}/common/Exceptional_value.jpg?1642073074`,
    title: 'Exceptional Value',
    description:
      'It’s a simple equation: PrintFast offers the most experience, the best products and customer service, all at competitive pricing. That adds up to an exceptional value for you. If you’re looking for a print and direct mail vendor who will support you with unparalleled quality and service, then you’ve found your solution.',
  },
];

// The letter from the President & CEO, faithful to the original page copy.
const letter = [
  'Welcome to PrintFast — where your ideas come to life with unparalleled precision and creativity. With decades of proven experience, we’re more than just a printing company; we’re your trusted partner in communication, marketing, and branding success. Since our establishment in 1903, we’ve honed our craft and built a solid reputation for delivering exceptional printed products on time and on budget.',
  'For over 35 years, we have focused on serving home service providers. Our products and marketing services are tailored specifically for trades such as HVAC, Plumbing, Electrical, Roofing, Siding, Window Installation, Driveway Paving, Landscaping, and Home Automation. Simply put, if you serve homeowners, we’re here to serve you.',
  'When you work with PrintFast, you’re not just another customer. You’re collaborating with a team of professionals who combine innovation with a personal touch to make your projects stress-free and extraordinary. From your first call, you’ll feel the difference: a commitment to your vision and a friendly, hands-on approach every step of the way.',
  'Whether you need a cutting-edge direct mail campaign, eye-catching marketing materials, or an enhanced digital presence through services like SEO and social engagement, PrintFast has you covered. Our custom solutions are tailored to your unique needs, ensuring your brand stands out in a crowded marketplace.',
  'As a third-generation owner, I’m deeply committed to upholding our family’s legacy of excellence. My personal guarantee to you: We will exceed your expectations with seamless communication, unmatched service, and superior quality in every product we create. Your satisfaction isn’t just a promise; it’s our priority.',
  'So why wait? Let’s turn your vision into reality. Reach out to our expert team today to discuss your printing, marketing, or digital projects. Prefer a direct conversation? I’m personally available to ensure your experience with PrintFast is nothing short of outstanding. Together, we’ll make your next project a resounding success!',
];

// Trades PrintFast is built to serve.
const trades = [
  'HVAC',
  'Plumbing',
  'Electrical',
  'Roofing',
  'Siding',
  'Window Installation',
  'Driveway Paving',
  'Landscaping',
  'Home Automation',
];

// Proof-point stats distilled from the page narrative.
const stats = [
  { value: 'Since 1903', label: 'Creating printed products on time and on budget' },
  { value: '35+ Years', label: 'Focused on serving home service providers' },
  { value: '3rd Gen', label: 'Family-owned, personally guaranteed' },
  { value: '100s', label: 'Custom products & services to choose from' },
];
---

<ShopLayout
  title="Who We Are | The PrintFast Story — Printing for Home Service Pros Since 1903"
  crumb="Who We Are"
  description="Meet PrintFast — a third-generation, family-owned printer serving home service pros since 1903. Custom print, direct mail and digital marketing delivered on time and on budget."
  keywords={[
    'who we are printfast',
    'about printfast',
    'home service printing company',
    'family owned printer since 1903',
    'HVAC marketing printer',
    'direct mail for contractors',
    'Bill McGowan PrintFast',
  ]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Who We Are — PrintFast',
    description:
      'PrintFast is a third-generation, family-owned printing and marketing company serving home service providers since 1903.',
    publisher: {
      '@type': 'Organization',
      name: 'PrintFast',
      foundingDate: '1903',
      telephone: '800-810-4818',
    },
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
            Who We Are
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
            More Than <span class="text-[#ED1C24]">Ink on Paper</span>
          </h1>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Just about any printer can put ink on paper. At PrintFast, the difference is our
            experience. Since 1903 we’ve been creating printed products — on time and on budget,
            every time.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            From your first call you’ll feel our friendly approach to the printing process. You’re
            working with professionals who take the anxiety out of printing.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Talk To Our Team <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href={shopHref('all-products')}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              Explore Our Products
            </a>
          </div>
        </div>

        <div class="relative" data-reveal>
          <div class="mx-auto max-w-sm rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur">
            <img
              src={ceoImg}
              alt="Bill McGowan, President and CEO of PrintFast"
              class="mx-auto h-auto w-full rounded-2xl object-cover"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <div class="mt-5 text-center">
              <p class="font-display text-xl font-bold uppercase tracking-wide text-white">Bill McGowan</p>
              <p class="mt-1 text-sm font-semibold uppercase tracking-[0.18em] text-[#ED1C24]">President, CEO</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== STATS BAR ===================== -->
  <section class="section-tight">
    <div class="container-pf">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {stats.map((s) => (
          <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-ink-100 shadow-soft">
            <p class="font-display text-2xl font-extrabold text-[#ED1C24] sm:text-3xl">{s.value}</p>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== A LETTER FROM OUR CEO ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-pen-fancy"></i> Who We Are
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">A message from our President &amp; CEO</h2>
      </div>

      <div class="mx-auto mt-12 max-w-3xl rounded-3xl bg-white p-8 ring-1 ring-ink-100 shadow-soft sm:p-12" data-reveal>
        <div class="space-y-5">
          {letter.map((p) => (
            <p class="text-base leading-relaxed text-ink-700">{p}</p>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-4 border-t border-ink-100 pt-6">
          <img
            src={ceoImg}
            alt="Bill McGowan, President and CEO of PrintFast"
            class="h-14 w-14 rounded-full object-cover ring-2 ring-[#ED1C24]/30"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="font-display text-lg font-bold uppercase tracking-wide text-[#0f2747]">Bill McGowan</p>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#ED1C24]">President, CEO</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WORLD CLASS RESULTS ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-award"></i> What Sets Us Apart
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Our team delivers world-class results, every time</h2>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {pillars.map((p) => (
          <div class="group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <div class="overflow-hidden bg-ink-50">
              <img
                src={p.img}
                alt={`PrintFast — ${p.title}`}
                class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{p.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{p.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WHO WE SERVE / TRADES ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-house-chimney"></i> Built For The Trades
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">Tailored for home service providers</h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-600">
            For over 35 years we’ve focused on serving home service providers. Our products and
            marketing services are tailored specifically for the trades. Simply put — if you serve
            homeowners, we’re here to serve you.
          </p>

          <div class="mt-8 flex flex-wrap gap-2.5">
            {trades.map((t) => (
              <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#0f2747] ring-1 ring-ink-100 shadow-soft">
                <i class="fa-solid fa-check text-xs text-[#ED1C24]"></i> {t}
              </span>
            ))}
          </div>

          <a
            href={shopHref('who-we-serve')}
            class="mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]"
          >
            See who we serve <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Testimonial -->
        <div class="relative rounded-3xl bg-[#0f2747] p-8 shadow-soft sm:p-10" data-reveal>
          <i class="fa-solid fa-quote-left text-4xl text-[#ED1C24]"></i>
          <blockquote class="mt-4 text-lg leading-relaxed text-white/90">
            As a third-generation owner, I’m deeply committed to upholding our family’s legacy of
            excellence. My personal guarantee: we will exceed your expectations with seamless
            communication, unmatched service, and superior quality in every product we create.
          </blockquote>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-[#ED1C24] font-display text-lg font-bold text-white">B</span>
            <div>
              <p class="font-bold text-white">Bill McGowan</p>
              <p class="text-sm text-white/60">President, CEO — PrintFast</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HAVE QUESTIONS / CALL ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 sm:p-14 lg:p-16" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
          <div>
            <h2 class="heading-lg text-white">
              Have <span class="text-[#ED1C24]">questions?</span>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-white/85">
              We’re available from 8 AM to 5 PM ET, Monday to Friday. Our team is here to help — and
              Bill is personally available to make sure your experience with PrintFast is nothing
              short of outstanding.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="tel:8008104818"
                class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
              >
                <i class="fa-solid fa-phone text-xs"></i> Call 800-810-4818
              </a>
              <a
                href={contactHref}
                class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
              >
                Send Us A Message
              </a>
            </div>
          </div>

          <div class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#ED1C24]">Hours</p>
            <p class="mt-2 text-lg font-bold text-white">8 AM – 5 PM ET</p>
            <p class="text-sm text-white/70">Monday to Friday</p>
            <p class="mt-5 text-xs font-bold uppercase tracking-[0.18em] text-[#ED1C24]">Phone</p>
            <p class="mt-2 text-lg font-bold text-white">800-810-4818</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
