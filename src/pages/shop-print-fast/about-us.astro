---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// The original "About Us Navigation" page is a hub that links out to every
// company / help page. We reproduce those exact destinations as a card grid.
const aboutLinks = [
  {
    title: 'Who We Are',
    href: shopHref('who-we-are'),
    icon: 'fa-users',
    description:
      'Meet the team behind PrintFast Marketing Solutions and the story that drives our direct mail and digital work.',
  },
  {
    title: 'Who We Serve',
    href: shopHref('who-we-serve'),
    icon: 'fa-handshake',
    description:
      'See the home service professionals and local businesses we help grow with proven marketing programs.',
  },
  {
    title: 'Let’s Move Forward Together',
    href: shopHref('lets-move-forward-together'),
    icon: 'fa-arrow-trend-up',
    description:
      'Discover how a true marketing partnership with PrintFast keeps your brand top of mind month after month.',
  },
  {
    title: '100% Satisfaction Guarantee',
    href: shopHref('satisfaction-guarantee'),
    icon: 'fa-shield-halved',
    description:
      'Every order is backed by our commitment to your complete satisfaction — that is the PrintFast promise.',
  },
  {
    title: 'Our Pledge of Service Excellence',
    href: shopHref('our-pledge-of-service-excellence'),
    icon: 'fa-award',
    description:
      'Read the standard we hold ourselves to on quality, turnaround and support for every single project.',
  },
  {
    title: 'FAQs',
    href: shopHref('faqs'),
    icon: 'fa-circle-question',
    description:
      'Get quick answers to the most common questions about ordering, artwork, mailing and turnaround times.',
  },
  {
    title: 'Terms & Conditions',
    href: shopHref('terms-of-use'),
    icon: 'fa-file-contract',
    description:
      'Review the terms of use that govern orders, artwork and services placed through PrintFast.',
  },
  {
    title: 'Upload Your Files',
    href: shopHref('upload-your-artwork'),
    icon: 'fa-cloud-arrow-up',
    description:
      'Ready to print? Send us your print-ready artwork through our secure file upload page.',
  },
  {
    title: 'Blog',
    href: shopHref('blog'),
    icon: 'fa-newspaper',
    description:
      'Marketing ideas, seasonal tips and direct mail strategy to help your business stay ahead.',
  },
];

const values = [
  {
    icon: 'fa-bolt',
    title: 'Fast Turnaround',
    description:
      'Speed is in our name. From design to mailbox, we move your campaigns quickly so you never miss the season.',
  },
  {
    icon: 'fa-pen-ruler',
    title: 'Full-Service Creative',
    description:
      'Professionally designed, brand-specific pieces — we handle the design, print and mailing so you do not have to.',
  },
  {
    icon: 'fa-envelopes-bulk',
    title: 'Direct Mail + Digital',
    description:
      'Combine targeted direct mail with digital marketing to reach the right homeowners on every channel.',
  },
  {
    icon: 'fa-headset',
    title: 'Real Human Support',
    description:
      'Our team is available 8 AM–5 PM ET, Monday to Friday, ready to help you plan and launch your next campaign.',
  },
];
---

<ShopLayout
  title="About PrintFast | Direct Mail & Digital Marketing for Home Service Pros"
  crumb="About Us"
  description="Learn about PrintFast Marketing Solutions — who we are, who we serve, our satisfaction guarantee and service pledge. Explore FAQs, terms, file upload and our blog."
  keywords={[
    'about PrintFast',
    'PrintFast Marketing Solutions',
    'direct mail marketing company',
    'home service marketing',
    'satisfaction guarantee',
    'service excellence pledge',
    'PrintFast contact',
  ]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PrintFast',
    legalName: 'PrintFast Marketing Solutions',
    description:
      'Direct mail and digital marketing solutions for home service professionals and local businesses.',
    telephone: '800-810-4818',
    email: 'info@print-fast.com',
    url: 'https://www.print-fast.com',
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
          About Us
        </p>
        <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Get To Know <span class="text-[#ED1C24]">PrintFast</span>
        </h1>
        <p class="mt-6 text-sm leading-relaxed text-white/80 sm:text-base">
          PrintFast Marketing Solutions helps home service professionals and local businesses grow
          with fast, full-service direct mail and digital marketing. From who we are to how we work
          with you, everything you need to know is right here.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href={shopHref('who-we-are')}
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Who We Are <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a
            href={contactHref}
            class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== ABOUT NAVIGATION CARDS ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-compass"></i> Explore About Us
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Everything you want to know about PrintFast</h2>
        <p class="lead mt-4">
          Browse our company pages, guarantees and resources — or reach out any time and our team
          will point you in the right direction.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {aboutLinks.map((link) => (
          <a
            href={link.href}
            class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40"
            data-reveal
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-lg text-[#ED1C24]">
              <i class={`fa-solid ${link.icon}`}></i>
            </span>
            <h3 class="mt-5 text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{link.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{link.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]">
              Learn More <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WHY PRINTFAST / VALUES ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-bolt"></i> Why PrintFast
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">A marketing partner built for speed and results</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#0f2747] text-lg text-white">
              <i class={`fa-solid ${v.icon}`}></i>
            </span>
            <h3 class="mt-5 text-sm font-extrabold uppercase tracking-wide text-[#0f2747]">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PROMISE + TESTIMONIAL ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-shield-halved"></i> Our Promise
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">Backed by a 100% satisfaction guarantee</h2>
          <ul class="mt-8 space-y-4">
            {[
              'Every order is backed by our commitment to your complete satisfaction.',
              'Professionally designed, brand-specific pieces personalized to your business.',
              'A dedicated team that treats your marketing like it is our own.',
            ].map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
                  <i class="fa-solid fa-check text-[10px]"></i>
                </span>
                <span class="text-ink-700">{point}</span>
              </li>
            ))}
          </ul>
          <a
            href={shopHref('satisfaction-guarantee')}
            class="mt-8 inline-flex items-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            See Our Guarantee <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Testimonial -->
        <div class="relative rounded-3xl bg-[#0f2747] p-8 shadow-soft sm:p-10" data-reveal>
          <i class="fa-solid fa-quote-left text-4xl text-[#ED1C24]"></i>
          <blockquote class="mt-4 text-lg leading-relaxed text-white/90">
            We love Print Fast! They are professional, honest, impressive and fast. They do a
            phenomenal job! I can’t say enough about them.
          </blockquote>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-[#ED1C24] font-display text-lg font-bold text-white">S</span>
            <div>
              <p class="font-bold text-white">Savannah H.</p>
              <p class="text-sm text-white/60">PrintFast client</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HAVE QUESTIONS ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 text-center sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative mx-auto max-w-2xl">
          <h2 class="heading-lg text-white">
            Have <span class="text-[#ED1C24]">questions?</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            We’re available from 8 AM to 5 PM ET, Monday to Friday — our team is here to help.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="tel:800-810-4818"
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              <i class="fa-solid fa-phone text-xs"></i> Call 800-810-4818
            </a>
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
