---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// Original PrintFast image assets (served from the same CDN/S3 the live store uses).
const S3 = 'https://nklopsouqd.s3.us-west-1.amazonaws.com/printfast/images/common';

const heroImg = `${S3}/HSC_SR_PC_09_21.png?1700933266`;

const whyChoose = [
  {
    img: `${S3}/Postcard_Marketing.png?1700933266`,
    title: 'Simple & Powerful Tool for Postcard Marketing',
    description: 'A 4” × 6” direct mail postcard — a simple yet powerful tool of postcard marketing.',
  },
  {
    img: `${S3}/Attractive_Color_Combination.png?1700933403`,
    title: 'Attractive Color Combination',
    description: 'Printed in black ink on yellow card stock to stand out in the mail.',
  },
  {
    img: `${S3}/Professionally_written_and_editable.png?1700751004`,
    title: 'Professionally Designed & Editable',
    description: 'All our Service Request Postcards are professionally designed and can be customized as per your needs.',
  },
  {
    img: `${S3}/reminders.png?1700933403`,
    title: 'Send Service Maintenance Reminders',
    description: 'Can be sent to your current comfort plan members as a reminder to schedule their maintenance service.',
  },
  {
    img: `${S3}/prospecting.png?1700933403`,
    title: 'Use for Prospecting New Clients',
    description: 'Can be used for prospecting new clients who might see this postcard as an official service notification that requires their response.',
  },
  {
    img: `${S3}/free_editing.png?1700933773`,
    title: 'Free Postcard Design Editing',
    description: 'No cost postcard design editing — you can save $65 on this service.',
  },
];

const didYouKnow = [
  'Our Service Request Postcards cost as low as 29¢ each (all costs including postage) for a minimum quantity of 1,000.',
  'No contracts or commitments for continued mailings.',
  'Feel free to contact us for more information.',
];

const relatedProducts = [
  {
    title: 'Radius Postcards',
    href: shopHref('radius-postcards'),
    description: 'Build credibility in the neighborhood with targeted, customizable radius mailings around every job.',
  },
  {
    title: 'Seasonal Postcards',
    href: shopHref('seasonal-postcards'),
    description: 'Stay top of mind year-round with VDP-enabled seasonal designs tailored to your brand.',
  },
  {
    title: 'Thank You Postcards',
    href: shopHref('thank-you-postcards'),
    description: 'Simple, low-cost and personalized thank-you cards that keep your customers coming back.',
  },
  {
    title: 'All Postcards',
    href: shopHref('printfast-postcards'),
    description: 'Explore the complete lineup of PrintFast jumbo direct mail postcard programs.',
  },
];
---

<ShopLayout
  title="Service Request Postcards | 1-Day HVAC Service Reminder Direct Mail"
  crumb="Service Request Postcards"
  description="PrintFast Service Request Postcards are the power tool of postcard marketing — 4×6 reminders that reschedule comfort-plan members and prospect new clients. Printed and mailed in one business day, as low as 29¢ each."
  keywords={[
    'service request postcards',
    'HVAC service reminder postcards',
    'maintenance reminder mailers',
    'comfort plan postcards',
    'direct mail prospecting postcards',
    'home service postcard marketing',
  ]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Service Request Postcards',
    description:
      '4"x6" service request direct mail postcards that remind comfort-plan members to schedule maintenance and prospect new clients, printed and mailed in one business day.',
    brand: { '@type': 'Brand', name: 'PrintFast' },
    category: 'Direct Mail Postcards',
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
            Direct Mail Postcards
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Service Request <span class="text-[#ED1C24]">Postcards</span>
          </h1>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Service Request postcards are often referred to as the power tool of postcard marketing.
            And just like power tools, they typically work fast and efficiently with great results —
            reminding your comfort-plan members to schedule maintenance while prospecting brand-new clients.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Our program is simple, low-cost, and best of all — very fast. Your postcards are printed and
            mailed in one business day once approved for production. Just send us your client list and we
            take care of the rest… guaranteed!
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Contact Us <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href={shopHref('printfast-postcards')}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              View All Postcards
            </a>
          </div>
        </div>

        <div class="relative" data-reveal>
          <img
            src={heroImg}
            alt="PrintFast Service Request Postcard printed in black ink on yellow card stock"
            class="mx-auto h-auto w-full max-w-md rounded-2xl"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INTRO / TWO GROUPS ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-bolt"></i> The Power Tool of Postcard Marketing
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Mail to two groups, win twice</h2>
        <p class="lead mt-5">
          Ideally, your Service Request postcards should be mailed to two different groups — turning a
          single design into both a retention and a prospecting engine.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <div class="flex flex-col rounded-2xl bg-white p-8 ring-1 ring-ink-100 shadow-soft" data-reveal>
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-xl text-[#ED1C24]">
            <i class="fa-solid fa-calendar-check"></i>
          </span>
          <h3 class="mt-5 text-lg font-extrabold uppercase tracking-wide text-[#0f2747]">Existing Clients</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">
            Mail them to your current comfort-plan members as a reminder to schedule their maintenance
            service — keeping equipment healthy and your calendar full.
          </p>
        </div>
        <div class="flex flex-col rounded-2xl bg-white p-8 ring-1 ring-ink-100 shadow-soft" data-reveal>
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-xl text-[#ED1C24]">
            <i class="fa-solid fa-user-plus"></i>
          </span>
          <h3 class="mt-5 text-lg font-extrabold uppercase tracking-wide text-[#0f2747]">New Prospects</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">
            Use them to prospect new clients who see the postcard as an official service notification
            that requires their response. Planning to prospect? Let’s talk about your target market — we
            provide the demographic research and quality mail lists to find your best new clients.
          </p>
        </div>
      </div>

      <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-ink-600" data-reveal>
        To obtain detailed product information and pricing, and access to our complete online store with
        hundreds of products for the home service professional, please
        <a href={contactHref} class="font-bold text-[#ED1C24]">create an account or log in</a>.
      </p>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE PRINTFAST ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-star"></i> Why PrintFast
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Why choose PrintFast for your Service Request Postcards?</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {whyChoose.map((w) => (
          <div class="flex flex-col items-center rounded-2xl bg-white p-6 text-center ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <img
              src={w.img}
              alt={w.title}
              width="120"
              height="120"
              class="h-20 w-20 object-contain"
              loading="lazy"
              decoding="async"
            />
            <h3 class="mt-4 text-sm font-extrabold uppercase tracking-wide text-[#0f2747]">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{w.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== DID YOU KNOW + TESTIMONIAL ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-lightbulb"></i> Did You Know?
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">A little goes a long way</h2>
          <ul class="mt-8 space-y-4">
            {didYouKnow.map((d) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
                  <i class="fa-solid fa-check text-[10px]"></i>
                </span>
                <span class="text-ink-700">{d}</span>
              </li>
            ))}
          </ul>
          <a
            href={contactHref}
            class="mt-8 inline-flex items-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Get More Information <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Testimonial -->
        <div class="relative rounded-3xl bg-[#0f2747] p-8 shadow-soft sm:p-10" data-reveal>
          <i class="fa-solid fa-quote-left text-4xl text-[#ED1C24]"></i>
          <blockquote class="mt-4 text-lg leading-relaxed text-white/90">
            I will never be able to express how much I have loved working with this company. They are
            professional, hardworking, loyal, and above all else extremely helpful. I would recommend
            PrintFast to anyone and I will always appreciate everything they did for me. Bill and Eric,
            you are the best!
          </blockquote>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-[#ED1C24] font-display text-lg font-bold text-white">K</span>
            <div>
              <p class="font-bold text-white">K. J.</p>
              <p class="text-sm text-white/60">PrintFast client</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== RELATED PRODUCTS ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-address-card"></i> More Postcard Programs
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Explore our other postcards</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {relatedProducts.map((p) => (
          <a href={p.href} class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <h3 class="text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{p.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]">
              View More <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative max-w-3xl">
          <h2 class="heading-lg text-white">
            Want to explore our <span class="text-[#ED1C24]">other products?</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            Visit our online store with 100+ marketing products for the home service professional by
            registering for access. We’re available from 8 AM to 5 PM ET, Monday to Friday — our team is
            here to help!
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Register Now <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href="tel:800-810-4818"
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              <i class="fa-solid fa-phone text-xs"></i> Call 800-810-4818
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
