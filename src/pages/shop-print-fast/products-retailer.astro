---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// The legacy /products-retailer.html page is the storefront's "Products" hub —
// a directory that links out to every PrintFast product category. We reproduce
// that same catalog here, rebuilt in the marketing theme.
const products = [
  {
    label: 'All Products',
    href: shopHref('all-products'),
    icon: 'fa-grip',
    blurb: 'Browse the full lineup of 100+ PrintFast marketing products in one place.',
  },
  {
    label: 'Product Overview',
    href: shopHref('ceow-products'),
    icon: 'fa-layer-group',
    blurb: 'A curated overview of our best-selling product collection for partner programs.',
  },
  {
    label: 'Door Hangers',
    href: shopHref('door-hangers'),
    icon: 'fa-door-open',
    blurb: 'High-impact door hangers that land your offer right on the doorknob.',
  },
  {
    label: 'Homeowner Experience Packs',
    href: shopHref('homeowner-experience-packs'),
    icon: 'fa-box-open',
    blurb: 'Leave-behind packs that turn every service call into a lasting impression.',
  },
  {
    label: 'Newsletters',
    href: shopHref('newsletters-new'),
    icon: 'fa-newspaper',
    blurb: 'Professionally written, editable newsletters that nurture your customer list.',
  },
  {
    label: 'Radius Postcards',
    href: shopHref('radius-postcards'),
    icon: 'fa-location-crosshairs',
    blurb: 'Spread the word around every job with targeted neighborhood radius mailings.',
  },
  {
    label: 'Recruiting Cards',
    href: shopHref('recruiting-cards'),
    icon: 'fa-user-plus',
    blurb: 'Recruit skilled technicians with mailers that sell your company as an employer.',
  },
  {
    label: 'Seasonal Postcards',
    href: shopHref('seasonal-postcards'),
    icon: 'fa-snowflake',
    blurb: 'VDP-enabled seasonal designs that keep you top of mind all year long.',
  },
  {
    label: 'Service Request Postcards',
    href: shopHref('service-request-postcards'),
    icon: 'fa-screwdriver-wrench',
    blurb: 'Service reminders for existing clients and prospecting for new ones.',
  },
  {
    label: 'Stickers',
    href: shopHref('stickers'),
    icon: 'fa-note-sticky',
    blurb: 'Branded stickers and labels that keep your name on every job.',
  },
  {
    label: 'Thank You Postcards',
    href: shopHref('thank-you-postcards'),
    icon: 'fa-heart',
    blurb: 'Simple, low-cost, personalized thank-you cards for your homeowners.',
  },
  {
    label: 'Yard Signs',
    href: shopHref('yard-signs'),
    icon: 'fa-sign-hanging',
    blurb: 'Durable yard signs that turn every completed job into a local billboard.',
  },
];

// Broad product families to help visitors orient before they dive in.
const categories = [
  {
    icon: 'fa-envelopes-bulk',
    title: 'Postcards & Mailers',
    description:
      'Jumbo postcards, radius mailings, seasonal designs and personalized mailers that put your brand right in the homeowner’s hands.',
  },
  {
    icon: 'fa-boxes-stacked',
    title: 'Print Products',
    description:
      'Door hangers, yard signs, stickers, newsletters and homeowner experience packs — a full catalog of home-service print marketing.',
  },
  {
    icon: 'fa-briefcase',
    title: 'Services & Solutions',
    description:
      'Creative design, full-service printing and done-for-you direct mail programs that handle the heavy lifting for you.',
  },
];

const whyChoose = [
  {
    icon: 'fa-bolt',
    title: 'Fast Turnaround',
    description: 'The name says it all — PrintFast gets your marketing designed, printed and mailed quickly.',
  },
  {
    icon: 'fa-pen-ruler',
    title: 'Professionally Designed',
    description: 'Every product is designed by our team and fully editable to match your brand, logo and colors.',
  },
  {
    icon: 'fa-house-chimney-user',
    title: 'Built for Home-Service Pros',
    description: 'Our entire catalog is purpose-built for HVAC, plumbing, electrical and other home-service trades.',
  },
  {
    icon: 'fa-file-signature',
    title: 'No Contracts',
    description: 'No long-term commitments or contracts — order what you need, when you need it.',
  },
  {
    icon: 'fa-shield-halved',
    title: '100% Satisfaction',
    description: 'Every order is backed by our satisfaction guarantee and pledge of service excellence.',
  },
];

const faqs = [
  {
    question: 'What products does PrintFast offer?',
    answer:
      'PrintFast offers a full catalog of print marketing products for home-service businesses — including jumbo postcards, door hangers, yard signs, stickers, newsletters, recruiting cards, homeowner experience packs and personalized mailers, plus creative design and full-service printing.',
  },
  {
    question: 'Are there any contracts or commitments?',
    answer:
      'No. There are no contracts or long-term commitments for continued mailings. You can order what you need, when you need it.',
  },
  {
    question: 'Can I customize the designs with my branding?',
    answer:
      'Yes. Every product is professionally designed and fully editable, so you can add your company logo, contact information, coupons and brand colors.',
  },
  {
    question: 'How do I get started or request a quote?',
    answer:
      'Contact our team and we’ll help you choose the right products and put together a quote. We’re available 8 AM–5 PM ET, Monday to Friday, or call 800-810-4818.',
  },
];
---

<ShopLayout
  title="Products Overview | PrintFast Print Marketing Product Catalog"
  crumb="Products Overview"
  description="Explore the full PrintFast product catalog — jumbo postcards, door hangers, yard signs, stickers, newsletters and mailers built for home-service pros. No contracts."
  keywords={[
    'PrintFast products',
    'home service marketing products',
    'direct mail postcards',
    'door hangers',
    'yard signs',
    'print marketing catalog',
    'HVAC marketing products',
  ]}
  faqs={faqs}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'PrintFast Products Overview',
    description:
      'The full PrintFast catalog of print marketing products for home-service professionals.',
    about: { '@type': 'Brand', name: 'PrintFast' },
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
          Products
        </p>
        <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Products <span class="text-[#ED1C24]">Overview</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-white/80 sm:text-base">
          Everything you need to fill the schedule, delivered. Explore our complete lineup of
          print marketing products — jumbo postcards, door hangers, yard signs, stickers,
          newsletters and personalized mailers — all designed and built for the home-service
          professional.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href={shopHref('all-products')}
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Browse All Products <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
          <a
            href={contactHref}
            class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
          >
            Request a Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRODUCT FAMILIES ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-sitemap"></i> Product Families
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Find the right product for the job</h2>
        <p class="lead mt-4">
          Our catalog is organized into three families so you can quickly zero in on what your
          business needs next.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <div class="flex flex-col rounded-2xl bg-white p-7 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-xl text-[#ED1C24]">
              <i class={`fa-solid ${c.icon}`}></i>
            </span>
            <h3 class="mt-5 text-lg font-extrabold uppercase tracking-wide text-[#0f2747]">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{c.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PRODUCT CATALOG ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-tags"></i> Our Products
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Explore the full PrintFast catalog</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40"
            data-reveal
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#0f2747] text-xl text-white transition-colors group-hover:bg-[#ED1C24]">
              <i class={`fa-solid ${p.icon}`}></i>
            </span>
            <h3 class="mt-5 text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{p.label}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{p.blurb}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]">
              View More <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WHY PRINTFAST ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-bolt"></i> Why PrintFast
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Why home-service pros choose PrintFast</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {whyChoose.map((w) => (
          <div class="flex flex-col items-center rounded-2xl bg-white p-6 text-center ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span class="grid h-14 w-14 place-items-center rounded-full bg-[#fde8e9] text-2xl text-[#ED1C24]">
              <i class={`fa-solid ${w.icon}`}></i>
            </span>
            <h3 class="mt-4 text-sm font-extrabold uppercase tracking-wide text-[#0f2747]">{w.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{w.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== HELP / TESTIMONIAL ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-headset"></i> Have Questions?
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">Not sure which product is right for you?</h2>
          <p class="lead mt-4">
            We’re available from 8 AM to 5 PM ET, Monday to Friday — our team is here to help you
            pick the products that will grow your business.
          </p>
          <ul class="mt-8 space-y-4">
            {[
              'One-to-one guidance choosing the right products for your goals.',
              'No contracts or commitments for continued mailings.',
              'Professionally designed, fully editable pieces branded to you.',
            ].map((d) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
                  <i class="fa-solid fa-check text-[10px]"></i>
                </span>
                <span class="text-ink-700">{d}</span>
              </li>
            ))}
          </ul>
          <a
            href={contactHref}
            class="mt-8 inline-flex items-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Call 800-810-4818 <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Testimonial -->
        <div class="relative rounded-3xl bg-[#0f2747] p-8 shadow-soft sm:p-10" data-reveal>
          <i class="fa-solid fa-quote-left text-4xl text-[#ED1C24]"></i>
          <blockquote class="mt-4 text-lg leading-relaxed text-white/90">
            We love Print Fast! They are professional, honest, impressive and fast. They do a
            phenomenal job! I can’t say enough about them.
          </blockquote>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-[#ED1C24] font-display text-lg font-bold text-white">S</span>
            <div>
              <p class="font-bold text-white">Savannah H.</p>
              <p class="text-sm text-white/60">PrintFast client</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-circle-question"></i> FAQs
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Frequently asked questions</h2>
      </div>

      <div class="mx-auto mt-10 max-w-3xl space-y-4">
        {faqs.map((f) => (
          <details class="group rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
              <span class="text-base font-bold text-[#0f2747]">{f.question}</span>
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24] transition-transform group-open:rotate-45">
                <i class="fa-solid fa-plus text-xs"></i>
              </span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-ink-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative max-w-3xl">
          <h2 class="heading-lg text-white">
            Ready to put PrintFast to <span class="text-[#ED1C24]">work for you?</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            Browse the full catalog or talk to our team about a custom marketing plan built around
            your business.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={shopHref('all-products')}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Browse All Products <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              Have Questions? Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
