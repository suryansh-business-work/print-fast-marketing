---
import ShopLayout from '@layouts/ShopLayout.astro';
import { shopHref } from '@data/shop';
import { getContactHref } from '@data/pricing';

const contactHref = getContactHref('digital-marketing-services');

// Original PrintFast image assets (served from the same CDN/S3 the live store uses).
const S3 = 'https://nklopsouqd.s3.us-west-1.amazonaws.com/printfast/images/common';

const heroImg = `${S3}/Postcard_Marketing.png?1701874973`;
const spotlightImg = `${S3}/Thank_You_PC_77.png?1701875072`;

const features = [
  {
    img: `${S3}/personalization_thank_you_postcards.png?1701874898`,
    title: 'Put Your Brand Into the Homeowner’s Hands',
    description:
      'An 8.5” × 5.5” direct mail postcard — a simple yet powerful marketing tool that lands your brand right in the homeowner’s hands.',
  },
  {
    img: `${S3}/Full_Color_Print.png?1701100779`,
    title: 'Full Color on Glossy Card Stock',
    description:
      'We’ll match your brand design so your message stands out in the homeowner’s mail on premium high-gloss card stock.',
  },
  {
    img: `${S3}/VDP_thank-you-postcards.png?1701972483`,
    title: 'Free Variable Data Personalization',
    description:
      'With Variable Data Personalization (VDP), you can personalize your marketing messaging to the next level — free of charge.',
  },
];

const didYouKnow = [
  'No contracts or commitments for continued mailings — send whenever you like.',
  'Give us a call today and we’ll show you just how easy it is to send custom Thank You postcards to your clients.',
];

const otherPostcards = [
  {
    title: 'Radius Postcards',
    icon: 'fa-location-crosshairs',
    href: shopHref('radius-postcards'),
    description:
      'Build credibility in the neighborhood by mailing to homeowners around every job you complete.',
  },
  {
    title: 'Seasonal Postcards',
    icon: 'fa-snowflake',
    href: shopHref('seasonal-postcards'),
    description:
      'Stay top of mind year-round with professionally designed, VDP-enabled seasonal postcards.',
  },
  {
    title: 'Service Request Postcards',
    icon: 'fa-screwdriver-wrench',
    href: shopHref('service-request-postcards'),
    description:
      'Send service reminders to existing clients and prospect for new ones with a single program.',
  },
  {
    title: 'All Postcards',
    icon: 'fa-address-card',
    href: shopHref('printfast-postcards'),
    description:
      'Explore every PrintFast postcard program built for the home service professional.',
  },
];
---

<ShopLayout
  title="Thank You Postcards | Personalized Direct Mail Thank You Cards for Home Service Pros"
  crumb="Thank You Postcards"
  description="Say thank you and win the next job. PrintFast Thank You Postcards are personalized, full-color, and mailed in one business day — as low as 77¢ each, minimum 10, no contracts."
  keywords={[
    'thank you postcards',
    'direct mail thank you cards',
    'personalized postcards',
    'home service marketing',
    'variable data postcards',
    'HVAC thank you postcards',
    'client appreciation mailers',
  ]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'PrintFast Thank You Postcards',
    description:
      'Personalized 8.5"×5.5" full-color Thank You postcards for home service professionals, printed and mailed in one business day. As low as 77¢ each, minimum 10, no contracts.',
    brand: { '@type': 'Brand', name: 'PrintFast' },
    category: 'Direct Mail Postcards',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: '0.77',
      availability: 'https://schema.org/InStock',
    },
  }}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden bg-[#0f2747]">
    <span aria-hidden="true" class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-[#ED1C24]/25 blur-3xl"></span>
    <span aria-hidden="true" class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-white/5 blur-3xl"></span>

    <div class="container-pf relative py-14 sm:py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex rounded-md bg-[#ED1C24] px-3 py-1.5 text-xs font-extrabold uppercase tracking-[0.18em] text-white">
            Direct Mail Postcards
          </p>
          <h1 class="mt-5 font-display text-4xl font-extrabold uppercase leading-[0.98] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Thank You <span class="text-[#ED1C24]">Postcards</span>
          </h1>
          <p class="mt-5 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Are you saying “Thank You” to your clients after each service call? Showing your gratitude
            with a simple Thank You postcard can be the key to your next service call from them. Don’t
            miss the opportunity to serve your clients at the highest level.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/80 sm:text-base">
            Our Thank You postcard program is simple, low-cost, personalized to your homeowners and
            best of all — it’s very fast. Your postcards are printed and mailed in one business day.
            Just send us your list and we take care of the rest… guaranteed!
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Contact Us <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href={shopHref('printfast-postcards')}
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              View All Postcards
            </a>
          </div>
        </div>

        <div class="relative" data-reveal>
          <img
            src={heroImg}
            alt="PrintFast personalized Thank You direct mail postcard for home service clients"
            class="mx-auto h-auto w-full max-w-md rounded-2xl"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WHY CHOOSE PRINTFAST ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-bolt"></i> Why PrintFast
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">
          Why choose PrintFast for your Thank You postcards?
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="flex flex-col items-center rounded-2xl bg-white p-8 text-center ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span
              class="icon-mask h-24 w-24 text-[#ED1C24]"
              style={`--icon:url('${f.img}')`}
              aria-hidden="true"
            />
            <h3 class="mt-5 text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== SPOTLIGHT / STAND OUT ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="relative order-last lg:order-first" data-reveal>
          <img
            src={spotlightImg}
            alt="Large 8.5 by 5.5 inch glossy PrintFast Thank You postcard"
            class="mx-auto h-auto w-full max-w-md rounded-2xl shadow-soft"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-envelope-open-text"></i> Built to Get Noticed
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">Large, glossy, and impossible to miss</h2>
          <p class="lead mt-5 text-ink-700">
            These postcards are large, glossy and will certainly stand out in the mail. Measuring
            8.5 inches wide by 5.5 inches high, they grab the homeowner’s attention because they’re
            larger than almost any other mail they receive.
          </p>
          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl bg-white p-5 text-center ring-1 ring-ink-100 shadow-soft">
              <p class="font-display text-3xl font-extrabold text-[#ED1C24]">77¢</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-600">Each, all-in</p>
            </div>
            <div class="rounded-2xl bg-white p-5 text-center ring-1 ring-ink-100 shadow-soft">
              <p class="font-display text-3xl font-extrabold text-[#ED1C24]">1 Day</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-600">Print &amp; mail</p>
            </div>
            <div class="rounded-2xl bg-white p-5 text-center ring-1 ring-ink-100 shadow-soft">
              <p class="font-display text-3xl font-extrabold text-[#ED1C24]">10</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink-600">Minimum qty</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== DID YOU KNOW + TESTIMONIAL ===================== -->
  <section class="section">
    <div class="container-pf">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
            <i class="fa-solid fa-lightbulb"></i> Did You Know?
          </p>
          <h2 class="heading-lg mt-4 text-[#0f2747]">A little gratitude goes a long way</h2>
          <ul class="mt-8 space-y-4">
            {didYouKnow.map((d) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#fde8e9] text-[#ED1C24]">
                  <i class="fa-solid fa-check text-[10px]"></i>
                </span>
                <span class="text-ink-700">{d}</span>
              </li>
            ))}
          </ul>
          <a
            href={contactHref}
            class="mt-8 inline-flex items-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
          >
            Get More Information <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        </div>

        <!-- Testimonial -->
        <div class="relative rounded-3xl bg-[#0f2747] p-8 shadow-soft sm:p-10" data-reveal>
          <i class="fa-solid fa-quote-left text-4xl text-[#ED1C24]"></i>
          <blockquote class="mt-4 text-lg leading-relaxed text-white/90">
            I will never be able to express how much I have loved working with this company. They are
            professional, hardworking, loyal, and above all else extremely helpful. I would recommend
            PrintFast to anyone and I will always appreciate everything they did for me. Bill and Eric,
            you are the best!
          </blockquote>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-[#ED1C24] font-display text-lg font-bold text-white">K</span>
            <div>
              <p class="font-bold text-white">K. J.</p>
              <p class="text-sm text-white/60">PrintFast client</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== EXPLORE OTHER POSTCARDS ===================== -->
  <section class="section bg-ink-50/60">
    <div class="container-pf">
      <div class="mx-auto max-w-3xl text-center" data-reveal>
        <p class="inline-flex items-center gap-2 rounded-full bg-[#fde8e9] px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-[#c01620]">
          <i class="fa-solid fa-address-card"></i> Our Products
        </p>
        <h2 class="heading-lg mt-4 text-[#0f2747]">Explore our other postcard programs</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {otherPostcards.map((p) => (
          <div class="group flex flex-col rounded-2xl bg-white p-6 ring-1 ring-ink-100 shadow-soft transition-all hover:-translate-y-1 hover:ring-[#ED1C24]/40" data-reveal>
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#fde8e9] text-[#ED1C24]">
              <i class={`fa-solid ${p.icon} text-lg`}></i>
            </span>
            <h3 class="mt-4 text-base font-extrabold uppercase tracking-wide text-[#0f2747]">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600">{p.description}</p>
            <a href={p.href} class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#ED1C24]">
              View More <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="section pt-0">
    <div class="container-pf">
      <div class="relative overflow-hidden rounded-3xl bg-[#0f2747] px-6 py-14 sm:p-14 lg:p-20" data-reveal>
        <span aria-hidden="true" class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/5 blur-3xl"></span>
        <span aria-hidden="true" class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-[#ED1C24]/30 blur-3xl"></span>
        <div class="relative max-w-3xl">
          <h2 class="heading-lg text-white">
            Want to explore our <span class="text-[#ED1C24]">other products?</span>
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/85">
            Visit our online store with over 100 marketing products for the home service professional.
            We’re available 8 AM to 5 PM ET, Monday to Friday — our team is here to help!
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={contactHref}
              class="inline-flex items-center justify-center gap-2 rounded-md bg-[#ED1C24] px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white shadow-lg transition-all hover:bg-[#c8161d] hover:shadow-xl active:translate-y-px"
            >
              Register Now <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href="tel:800-810-4818"
              class="inline-flex items-center justify-center gap-2 rounded-md px-7 py-4 text-sm font-extrabold uppercase tracking-wide text-white ring-1 ring-white/40 transition-all hover:bg-white/10"
            >
              <i class="fa-solid fa-phone text-xs"></i> Call 800-810-4818
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ShopLayout>
