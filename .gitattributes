# Normalize line endings. The shell scripts and Dockerfiles below run on Linux
# (the VPS and CI); a CRLF checkout on Windows would break the shebang.
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
