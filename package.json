{
  "name": "print-fast-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PrintFast monorepo — marketing site (9000), shop site (9001), ROAS app (9002) and ROAS API (9003) sharing one design system.",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @print-fast/main-website --filter @print-fast/shop-website --parallel --stream dev",
    "dev:main": "pnpm --filter @print-fast/main-website dev",
    "dev:shop": "pnpm --filter @print-fast/shop-website dev",
    "dev:roas": "pnpm --filter ./roas/client --filter ./roas/server --parallel --stream dev",
    "dev:roas:client": "pnpm --filter roas-printfast-client dev",
    "dev:roas:server": "pnpm --filter roas-printfast-server dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @print-fast/main-website --filter @print-fast/shop-website build",
    "build:main": "pnpm --filter @print-fast/main-website build",
    "build:shop": "pnpm --filter @print-fast/shop-website build",
    "build:roas": "pnpm --filter ./roas/client --filter ./roas/server build",
    "preview": "pnpm --filter @print-fast/main-website --filter @print-fast/shop-website --parallel --stream preview",
    "verify": "pnpm build:web && pnpm check:links",
    "check:links": "node scripts/check-links.mjs",
    "sync:public": "node scripts/sync-public.mjs",
    "nginx:render": "node scripts/render-nginx.mjs",
    "type-check": "pnpm -r --if-present type-check",
    "lint": "pnpm -r --if-present lint",
    "clean": "node scripts/clean.mjs",
    "ssl:issue": "node scripts/ssl.mjs issue",
    "ssl:renew": "node scripts/ssl.mjs renew",
    "ssl:renew:dry": "node scripts/ssl.mjs renew --dry-run",
    "ssl:status": "node scripts/ssl.mjs status",
    "ssl:timer": "node scripts/ssl.mjs timer",
    "remote:status": "node scripts/ssl.mjs remote-status"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
