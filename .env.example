# =============================================================================
# PrintFast monorepo — ONE .env at the repo root feeds every app.
# Copy to `.env` and fill in. Never commit `.env`.
#
#   main-website   9000   marketing.print-fast.com
#   shop-website   9001   shop.print-fast.com
#   roas/client    9002   roas.print-fast.com
#   roas/server    9003   roas-server.print-fast.com
# =============================================================================


# -----------------------------------------------------------------------------
# Cross-site origins (Astro — PUBLIC_* is inlined into the built HTML)
#
# These decide when a shared header/footer link stays relative and when it
# becomes an absolute cross-origin URL. Point them at localhost to click
# between the two sites while developing.
# -----------------------------------------------------------------------------
PUBLIC_MAIN_SITE_URL=https://print-fast.com
PUBLIC_SHOP_SITE_URL=https://shop.print-fast.com
PUBLIC_ROAS_APP_URL=https://roas.print-fast.com
PUBLIC_ROAS_API_URL=https://roas-server.print-fast.com

# Local dev alternative:
# PUBLIC_MAIN_SITE_URL=http://localhost:9000
# PUBLIC_SHOP_SITE_URL=http://localhost:9001

# Dev server ports (optional — defaults shown)
# MAIN_SITE_PORT=9000
# SHOP_SITE_PORT=9001
# ROAS_CLIENT_PORT=9002


# -----------------------------------------------------------------------------
# Zoho Forms — where the shared contact form posts its leads.
#
# Optional: the live form permalink is the built-in default. Set this to point
# the sites at a different (e.g. test) Zoho form. Grab the value from Zoho:
# Share → Embed → HTML, and copy the <form action="…"> URL verbatim.
# -----------------------------------------------------------------------------
# PUBLIC_ZOHO_CONTACT_FORM_URL=https://forms.zohopublic.com/printfastllc/form/…/htmlRecords/submit


# -----------------------------------------------------------------------------
# ROAS server (roas/server)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=9003

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/roas-printfast

# Long random strings — generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
SESSION_MAX_AGE=86400000

# Origins allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:9002

# Feature flags
ALLOW_ADMIN_SIGNUP=false
ALLOW_SEND_GOD_CREDENTIALS=true

# Seeded super-admin (pnpm --filter roas-printfast-server seed:god-user)
GOD_USER_EMAIL=admin@roasprintfast.com
GOD_USER_PASSWORD=ChangeThisPassword123!
GOD_USER_FIRST_NAME=Super
GOD_USER_LAST_NAME=Admin

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINTS=

# ServiceTitan integration (optional)
SERVICE_TITAN_APP_KEY=
# SERVICE_TITAN_AUTH_URL=https://auth.servicetitan.io/connect/token
# SERVICE_TITAN_API_URL=https://api.servicetitan.io
# SYNC_CRON_SCHEDULE=0 */6 * * *

# OpenAI (future use)
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# ROAS client (roas/client) — VITE_* is embedded at build time
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:9003/api/v1
VITE_GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# Local deploy / SSL helper scripts (pnpm ssl:renew, pnpm ssl:issue)
# CI does not use these — GitHub Actions secrets cover the pipeline.
# -----------------------------------------------------------------------------
DEPLOY_HOST=31.220.49.107
DEPLOY_USER=root
# Either set a password (requires sshpass) or leave blank to use your SSH key.
DEPLOY_SSH_PASSWORD=
CERTBOT_EMAIL=
